#!/usr/bin/env python3
"""Create, list, upload, download, and restore MyGit backups."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path
from urllib.parse import urlparse

from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC

PROJECT_DIR = Path(__file__).resolve().parent.parent
DEFAULT_BACKUP_ROOT = Path(os.environ.get("MYGIT_BACKUP_ROOT", PROJECT_DIR / "backups"))
DEFAULT_REPOS_DIR = Path(os.environ.get("MYGIT_REPOS_ROOT", PROJECT_DIR / "repos"))
DEFAULT_MEDIA_DIR = Path(os.environ.get("MYGIT_MEDIA_ROOT", PROJECT_DIR / "media"))
DEFAULT_DATABASE_URL = os.environ.get("DATABASE_URL", f"sqlite:///{PROJECT_DIR / 'db.sqlite3'}")
ENCRYPTED_SUFFIX = ".enc"
ENCRYPTION_MAGIC = b"MYGITBACKUPENC1\n"
ENCRYPTION_ITERATIONS = 390_000
GCM_TAG_SIZE = 16
CHUNK_SIZE = 1024 * 1024


class BackupError(RuntimeError):
    pass


def run(command: list[str], *, stdout=None) -> None:
    try:
        subprocess.run(command, check=True, stdout=stdout)
    except FileNotFoundError as exc:
        raise BackupError(f"Required command not found: {command[0]}") from exc
    except subprocess.CalledProcessError as exc:
        message = f"Command failed with exit code {exc.returncode}: {' '.join(command)}"
        raise BackupError(message) from exc


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def encryption_password() -> bytes:
    password = os.environ.get("MYGIT_BACKUP_ENCRYPTION_KEY", "")
    if not password:
        raise BackupError("Set MYGIT_BACKUP_ENCRYPTION_KEY before using encrypted backups")
    return password.encode("utf-8")


def derive_encryption_key(password: bytes, salt: bytes, iterations: int) -> bytes:
    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(),
        length=32,
        salt=salt,
        iterations=iterations,
    )
    return kdf.derive(password)


def encrypt_file(source: Path, target: Path) -> None:
    salt = os.urandom(16)
    nonce = os.urandom(12)
    key = derive_encryption_key(encryption_password(), salt, ENCRYPTION_ITERATIONS)
    header = {
        "algorithm": "AES-256-GCM",
        "kdf": "PBKDF2-HMAC-SHA256",
        "iterations": ENCRYPTION_ITERATIONS,
        "salt": salt.hex(),
        "nonce": nonce.hex(),
    }
    header_bytes = json.dumps(header, separators=(",", ":")).encode("utf-8")
    encryptor = Cipher(algorithms.AES(key), modes.GCM(nonce)).encryptor()

    with source.open("rb") as src, target.open("wb") as dst:
        dst.write(ENCRYPTION_MAGIC)
        dst.write(len(header_bytes).to_bytes(4, "big"))
        dst.write(header_bytes)
        for chunk in iter(lambda: src.read(CHUNK_SIZE), b""):
            dst.write(encryptor.update(chunk))
        dst.write(encryptor.finalize())
        dst.write(encryptor.tag)


def decrypt_file(source: Path, target: Path) -> None:
    with source.open("rb") as src:
        if src.read(len(ENCRYPTION_MAGIC)) != ENCRYPTION_MAGIC:
            raise BackupError(f"Encrypted backup has an invalid header: {source}")
        header_len = int.from_bytes(src.read(4), "big")
        header = json.loads(src.read(header_len).decode("utf-8"))
        salt = bytes.fromhex(header["salt"])
        nonce = bytes.fromhex(header["nonce"])
        iterations = int(header["iterations"])
        key = derive_encryption_key(encryption_password(), salt, iterations)

        ciphertext_start = src.tell()
        src.seek(0, os.SEEK_END)
        ciphertext_end = src.tell() - GCM_TAG_SIZE
        if ciphertext_end <= ciphertext_start:
            raise BackupError(f"Encrypted backup payload is empty: {source}")
        src.seek(ciphertext_end)
        tag = src.read(GCM_TAG_SIZE)
        src.seek(ciphertext_start)

        decryptor = Cipher(algorithms.AES(key), modes.GCM(nonce, tag)).decryptor()
        remaining = ciphertext_end - ciphertext_start
        with target.open("wb") as dst:
            while remaining:
                chunk = src.read(min(CHUNK_SIZE, remaining))
                if not chunk:
                    break
                remaining -= len(chunk)
                dst.write(decryptor.update(chunk))
            dst.write(decryptor.finalize())


def prepare_archive_for_read(archive_path: Path, tmp_path: Path) -> Path:
    if archive_path.suffix != ENCRYPTED_SUFFIX:
        return archive_path
    decrypted_path = tmp_path / archive_path.with_suffix("").name
    decrypt_file(archive_path, decrypted_path)
    return decrypted_path


def copy_tree(src: Path, dst: Path) -> None:
    if src.exists():
        shutil.copytree(src, dst, dirs_exist_ok=True)


def backup_database(database_url: str, output_dir: Path) -> str:
    if database_url.startswith("sqlite:///"):
        db_path = Path(database_url.removeprefix("sqlite:///"))
        if not db_path.exists():
            raise BackupError(f"SQLite database not found: {db_path}")
        shutil.copy2(db_path, output_dir / "db.sqlite3")
        return "sqlite"

    parsed = urlparse(database_url)
    if parsed.scheme in {"postgres", "postgresql"}:
        with (output_dir / "db.sql").open("wb") as handle:
            run(["pg_dump", database_url], stdout=handle)
        return "postgres"

    raise BackupError(f"Unsupported DATABASE_URL scheme: {database_url}")


def write_manifest(staging_dir: Path, *, db_engine: str, label: str | None) -> None:
    files: dict[str, dict[str, int | str]] = {}
    for path in sorted(staging_dir.rglob("*")):
        if path.is_file() and path.name != "manifest.json":
            rel = path.relative_to(staging_dir).as_posix()
            files[rel] = {"size": path.stat().st_size, "sha256": sha256_file(path)}

    manifest = {
        "app": "MyGit",
        "version": 1,
        "label": label or "",
        "created_at": dt.datetime.now(dt.UTC).isoformat(),
        "database_engine": db_engine,
        "includes": ["database", "repos", "media", "env"],
        "files": files,
    }
    (staging_dir / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")


def verify_manifest(staging_dir: Path) -> dict:
    manifest_path = staging_dir / "manifest.json"
    if not manifest_path.exists():
        raise BackupError("Backup manifest.json is missing")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    for rel, meta in manifest.get("files", {}).items():
        path = staging_dir / rel
        if not path.exists():
            raise BackupError(f"Backup file missing: {rel}")
        if sha256_file(path) != meta["sha256"]:
            raise BackupError(f"Checksum mismatch: {rel}")
    return manifest


def make_archive(staging_dir: Path, output_path: Path) -> None:
    with tarfile.open(output_path, "w:gz") as archive:
        archive.add(staging_dir, arcname=staging_dir.name)


def extract_archive(archive_path: Path, target_dir: Path) -> Path:
    with tarfile.open(archive_path, "r:gz") as archive:
        archive.extractall(target_dir, filter="data")
    children = [path for path in target_dir.iterdir() if path.is_dir()]
    if len(children) != 1:
        raise BackupError("Backup archive has an unexpected structure")
    return children[0]


def verify_archive(archive_path: Path) -> dict:
    with tempfile.TemporaryDirectory(prefix="mygit-verify-") as tmp:
        tmp_path = Path(tmp)
        readable_archive = prepare_archive_for_read(archive_path, tmp_path)
        staging_dir = extract_archive(readable_archive, tmp_path / "extract")
        return verify_manifest(staging_dir)


def cloud_config() -> tuple[str, str]:
    provider = os.environ.get("MYGIT_BACKUP_CLOUD_PROVIDER", "").strip().lower()
    target = os.environ.get("MYGIT_BACKUP_CLOUD_TARGET", "").strip()
    if not provider or not target:
        raise BackupError("Set MYGIT_BACKUP_CLOUD_PROVIDER and MYGIT_BACKUP_CLOUD_TARGET first")
    if provider not in {"rclone", "s3"}:
        raise BackupError("MYGIT_BACKUP_CLOUD_PROVIDER must be 'rclone' or 's3'")
    return provider, target.rstrip("/")


def cloud_upload(archive_path: Path) -> None:
    provider, target = cloud_config()
    if provider == "rclone":
        run(["rclone", "copy", str(archive_path), target])
    else:
        run(["aws", "s3", "cp", str(archive_path), f"{target}/{archive_path.name}"])


def cloud_download(name: str, output_dir: Path) -> Path:
    provider, target = cloud_config()
    output_path = output_dir / Path(name).name
    if provider == "rclone":
        run(["rclone", "copyto", f"{target}/{name}", str(output_path)])
    else:
        run(["aws", "s3", "cp", f"{target}/{name}", str(output_path)])
    return output_path


def cloud_list() -> None:
    provider, target = cloud_config()
    if provider == "rclone":
        run(["rclone", "lsf", target])
    else:
        run(["aws", "s3", "ls", f"{target}/"])


def prune_local_backups(root: Path, keep: int) -> None:
    if keep <= 0 or not root.exists():
        return
    archives = sorted(
        [*root.glob("mygit-backup-*.tar.gz"), *root.glob("mygit-backup-*.tar.gz.enc")],
        key=lambda path: path.stat().st_mtime,
    )
    for archive in archives[:-keep]:
        archive.unlink()


def create_backup(args: argparse.Namespace) -> Path:
    backup_root = Path(args.output or DEFAULT_BACKUP_ROOT)
    backup_root.mkdir(parents=True, exist_ok=True)
    timestamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    label_suffix = f"-{args.label}" if args.label else ""
    archive_path = backup_root / f"mygit-backup-{timestamp}{label_suffix}.tar.gz"

    with tempfile.TemporaryDirectory(prefix="mygit-backup-") as tmp:
        staging_dir = Path(tmp) / archive_path.stem.removesuffix(".tar")
        staging_dir.mkdir()
        db_engine = backup_database(args.database_url, staging_dir)
        copy_tree(args.repos_dir, staging_dir / "repos")
        copy_tree(args.media_dir, staging_dir / "media")
        env_path = PROJECT_DIR / ".env"
        if env_path.exists():
            shutil.copy2(env_path, staging_dir / ".env")
        write_manifest(staging_dir, db_engine=db_engine, label=args.label)
        make_archive(staging_dir, archive_path)

    if args.encrypt:
        encrypted_path = Path(f"{archive_path}{ENCRYPTED_SUFFIX}")
        encrypt_file(archive_path, encrypted_path)
        archive_path.unlink()
        archive_path = encrypted_path

    print(f"Backup created: {archive_path}")
    print(f"SHA256: {sha256_file(archive_path)}")
    if args.upload:
        cloud_upload(archive_path)
        print("Cloud upload complete.")
    prune_local_backups(backup_root, args.keep_local)
    return archive_path


def list_backups(args: argparse.Namespace) -> None:
    root = Path(args.output or DEFAULT_BACKUP_ROOT)
    archives = [*root.glob("mygit-backup-*.tar.gz"), *root.glob("mygit-backup-*.tar.gz.enc")]
    for archive in sorted(archives, reverse=True):
        size_mb = archive.stat().st_size / 1024 / 1024
        print(f"{archive.name}\t{size_mb:.1f} MB\t{archive}")
    if args.cloud:
        cloud_list()


def restore_database(database_url: str, staging_dir: Path, manifest: dict) -> None:
    engine = manifest.get("database_engine")
    if engine == "sqlite":
        if not database_url.startswith("sqlite:///"):
            raise BackupError("Backup is SQLite, but target DATABASE_URL is not SQLite")
        target = Path(database_url.removeprefix("sqlite:///"))
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(staging_dir / "db.sqlite3", target)
        return

    if engine == "postgres":
        if urlparse(database_url).scheme not in {"postgres", "postgresql"}:
            raise BackupError("Backup is PostgreSQL, but target DATABASE_URL is not PostgreSQL")
        run(["psql", database_url, "-v", "ON_ERROR_STOP=1", "-c", "DROP SCHEMA public CASCADE;"])
        run(["psql", database_url, "-v", "ON_ERROR_STOP=1", "-c", "CREATE SCHEMA public;"])
        run(["psql", database_url, "-v", "ON_ERROR_STOP=1", "-f", str(staging_dir / "db.sql")])
        return

    raise BackupError(f"Unsupported backup database engine: {engine}")


def restore_backup(args: argparse.Namespace) -> None:
    if not args.yes:
        print("Restore will overwrite the target database, repositories, and media files.")
        answer = input("Type RESTORE to continue: ")
        if answer != "RESTORE":
            raise BackupError("Restore cancelled")

    with tempfile.TemporaryDirectory(prefix="mygit-restore-") as tmp:
        tmp_path = Path(tmp)
        archive_path = Path(args.archive)
        if args.from_cloud:
            archive_path = cloud_download(args.archive, tmp_path)
        readable_archive = prepare_archive_for_read(archive_path, tmp_path)
        staging_dir = extract_archive(readable_archive, tmp_path / "extract")
        manifest = verify_manifest(staging_dir)

        restore_database(args.database_url, staging_dir, manifest)

        for source_name, target_dir in (("repos", args.repos_dir), ("media", args.media_dir)):
            source = staging_dir / source_name
            if source.exists():
                if target_dir.exists():
                    shutil.rmtree(target_dir)
                shutil.copytree(source, target_dir)

    print("Restore complete.")


def verify_backup(args: argparse.Namespace) -> None:
    manifest = verify_archive(Path(args.archive))
    print("Backup verified.")
    print(f"Created at: {manifest.get('created_at', '-')}")
    print(f"Database: {manifest.get('database_engine', '-')}")
    print(f"Files: {len(manifest.get('files', {}))}")


def sqlite_integrity_check(path: Path) -> None:
    connection = sqlite3.connect(path)
    try:
        result = connection.execute("PRAGMA integrity_check").fetchone()
    finally:
        connection.close()
    if not result or result[0] != "ok":
        raise BackupError(f"SQLite integrity_check failed: {result[0] if result else 'no result'}")


def test_restore(args: argparse.Namespace) -> None:
    with tempfile.TemporaryDirectory(prefix="mygit-test-restore-") as tmp:
        tmp_path = Path(tmp)
        archive_path = Path(args.archive)
        if args.from_cloud:
            archive_path = cloud_download(args.archive, tmp_path)
        readable_archive = prepare_archive_for_read(archive_path, tmp_path)
        staging_dir = extract_archive(readable_archive, tmp_path / "extract")
        manifest = verify_manifest(staging_dir)

        restored_root = tmp_path / "restored"
        restored_db = restored_root / "db.sqlite3"
        restored_repos = restored_root / "repos"
        restored_media = restored_root / "media"
        restored_root.mkdir()

        if manifest.get("database_engine") == "sqlite":
            restore_database(f"sqlite:///{restored_db}", staging_dir, manifest)
            sqlite_integrity_check(restored_db)
        elif manifest.get("database_engine") == "postgres":
            if not args.database_url:
                print(
                    "PostgreSQL dump verified by checksum; pass --database-url "
                    "to test full restore."
                )
            else:
                restore_database(args.database_url, staging_dir, manifest)
        else:
            engine = manifest.get("database_engine")
            raise BackupError(f"Unsupported backup database engine: {engine}")

        for source_name, target_dir in (("repos", restored_repos), ("media", restored_media)):
            source = staging_dir / source_name
            if source.exists():
                shutil.copytree(source, target_dir)

    print("Test restore complete.")


def replicate_repos(args: argparse.Namespace) -> None:
    provider, target = cloud_config()
    source = str(args.repos_dir)
    if provider == "rclone":
        command = ["rclone", "sync" if args.delete else "copy", source, f"{target}/repos"]
        run(command)
    else:
        command = ["aws", "s3", "sync", source, f"{target}/repos"]
        if args.delete:
            command.append("--delete")
        run(command)
    print("Repository replication complete.")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="MyGit backup and restore utility")
    subparsers = parser.add_subparsers(dest="command")

    def add_common(subparser: argparse.ArgumentParser) -> None:
        subparser.add_argument("--database-url", default=DEFAULT_DATABASE_URL)
        subparser.add_argument("--repos-dir", type=Path, default=DEFAULT_REPOS_DIR)
        subparser.add_argument("--media-dir", type=Path, default=DEFAULT_MEDIA_DIR)

    create = subparsers.add_parser("create", help="create a backup archive")
    add_common(create)
    create.add_argument("-o", "--output", type=Path, default=DEFAULT_BACKUP_ROOT)
    create.add_argument("--label", default="")
    create.add_argument(
        "--encrypt",
        action="store_true",
        help="encrypt archive before upload/storage",
    )
    create.add_argument(
        "--upload",
        action="store_true",
        help="upload archive to configured cloud target",
    )
    create.add_argument(
        "--keep-local",
        type=int,
        default=int(os.environ.get("MYGIT_BACKUP_KEEP_LOCAL", "14")),
    )
    create.set_defaults(func=create_backup)

    listing = subparsers.add_parser("list", help="list local and optionally cloud backups")
    listing.add_argument("-o", "--output", type=Path, default=DEFAULT_BACKUP_ROOT)
    listing.add_argument("--cloud", action="store_true")
    listing.set_defaults(func=list_backups)

    restore = subparsers.add_parser("restore", help="restore from a backup archive")
    add_common(restore)
    restore.add_argument("archive", help="local archive path or cloud object name")
    restore.add_argument("--from-cloud", action="store_true")
    restore.add_argument("-y", "--yes", action="store_true")
    restore.set_defaults(func=restore_backup)

    verify = subparsers.add_parser("verify", help="verify manifest and checksums")
    verify.add_argument("archive", type=Path)
    verify.set_defaults(func=verify_backup)

    test = subparsers.add_parser("test-restore", help="restore into a temporary staging directory")
    test.add_argument("archive", help="local archive path or cloud object name")
    test.add_argument("--from-cloud", action="store_true")
    test.add_argument(
        "--database-url",
        default="",
        help="optional throwaway PostgreSQL DATABASE_URL for full dump restore testing",
    )
    test.set_defaults(func=test_restore)

    replicate = subparsers.add_parser(
        "replicate-repos",
        help="replicate repositories to cloud target",
    )
    replicate.add_argument("--repos-dir", type=Path, default=DEFAULT_REPOS_DIR)
    replicate.add_argument(
        "--delete",
        action="store_true",
        help="delete remote files missing locally",
    )
    replicate.set_defaults(func=replicate_repos)

    upload = subparsers.add_parser("upload", help="upload an existing archive to cloud")
    upload.add_argument("archive", type=Path)
    upload.set_defaults(func=lambda args: cloud_upload(args.archive))

    download = subparsers.add_parser("download", help="download a cloud archive")
    download.add_argument("name")
    download.add_argument("-o", "--output", type=Path, default=DEFAULT_BACKUP_ROOT)
    download.set_defaults(func=lambda args: print(cloud_download(args.name, args.output)))

    return parser


def normalize_legacy_args(argv: list[str]) -> list[str]:
    commands = {
        "create",
        "download",
        "list",
        "replicate-repos",
        "restore",
        "test-restore",
        "upload",
        "verify",
    }
    if len(argv) == 2 and not argv[1].startswith("-") and argv[1] not in commands:
        return [argv[0], "create", "--output", argv[1]]
    return argv


def main() -> int:
    parser = build_parser()
    args = parser.parse_args(normalize_legacy_args(sys.argv)[1:])
    if not hasattr(args, "func"):
        parser.print_help()
        return 2
    try:
        args.func(args)
    except BackupError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
