#!/usr/bin/env python3
"""
MyGit CI Runner.
Polls the server for pending jobs, executes them in Docker containers, and reports results.

Usage:
    ./mygit-runner --url http://127.0.0.1:8000 --token mytoken --runner-id worker1
"""
import argparse
import json
import os
import shlex
import subprocess
import sys
import time
import urllib.request
import urllib.error


def api_request(method, url, token, data=None):
    headers = {"Authorization": f"Bearer {token}"}
    if data is not None:
        headers["Content-Type"] = "application/json"
        req = urllib.request.Request(url, data=json.dumps(data).encode(), headers=headers, method=method)
    else:
        req = urllib.request.Request(url, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        print(f"HTTP error: {e.code} {e.read().decode()}", file=sys.stderr)
        return None
    except Exception as e:
        print(f"Request error: {e}", file=sys.stderr)
        return None


def run_job_in_docker(api_url, token, runner_id, image, script, project_id, pipeline_id, job_id):
    """Run job script inside a Docker container."""
    # Create a temporary directory for the workspace
    import tempfile
    with tempfile.TemporaryDirectory() as workspace:
        # Build docker run command
        docker_cmd = [
            "docker", "run", "--rm",
            "-v", f"{workspace}:/workspace",
            "-w", "/workspace",
            image,
            "sh", "-c",
        ]
        
        # Prepare the full script with checkout
        repo_path = f"/workspace/repo"
        full_script = f"set -e\n"
        full_script += f"git clone --depth=1 --branch {os.environ.get('CI_COMMIT_REF', 'main')} {os.environ.get('CI_REPOSITORY_URL', '')} {repo_path} 2>/dev/null || git clone {os.environ.get('CI_REPOSITORY_URL', '')} {repo_path}\n"
        full_script += f"cd {repo_path}\n"
        full_script += f"git checkout {os.environ.get('CI_COMMIT_SHA', 'HEAD')} 2>/dev/null || true\n"
        
        for cmd in script:
            full_script += f"{cmd}\n"
        
        docker_cmd.append(full_script)
        
        print(f"Running job in Docker container: {image}")
        print(f"Workspace: {workspace}")
        
        proc = subprocess.run(docker_cmd, capture_output=True, text=True, timeout=3600)
        
        # Send logs
        if proc.stdout:
            api_request(
                "POST",
                f"{api_url}/api/v1/projects/{project_id}/pipelines/{pipeline_id}/jobs/{job_id}/update_log/",
                token,
                data={"log": proc.stdout},
            )
        if proc.stderr:
            api_request(
                "POST",
                f"{api_url}/api/v1/projects/{project_id}/pipelines/{pipeline_id}/jobs/{job_id}/update_log/",
                token,
                data={"log": proc.stderr},
            )
        
        return proc.returncode == 0, proc.stdout + proc.stderr


def run_job(api_url, token, runner_id):
    resp = api_request(
        "GET",
        f"{api_url}/api/v1/internal/ci/jobs/pending",
        token,
    )
    if not resp or not resp.get("jobs") or len(resp["jobs"]) == 0:
        return False

    job = resp["jobs"][0]
    pipeline_path = job.get("pipeline", "")
    if "/" not in pipeline_path:
        return False
    project_id, pipeline_id = pipeline_path.split("/", 1)
    job_id = job.get("id", "")

    # Claim the job
    claim_resp = api_request(
        "POST",
        f"{api_url}/api/v1/projects/{project_id}/pipelines/{pipeline_id}/jobs/{job_id}/claim/",
        token,
        data={"runner_id": runner_id},
    )
    if not claim_resp:
        return False

    script = claim_resp.get("script", [])
    image = claim_resp.get("image", "python:3.12-slim")

    print(f"Running job: {claim_resp['name']} (stage: {claim_resp['stage']})")
    print(f"Image: {image}")
    print(f"Script: {script}")

    # Send start log
    api_request(
        "POST",
        f"{api_url}/api/v1/projects/{project_id}/pipelines/{pipeline_id}/jobs/{job_id}/update_log/",
        token,
        data={"log": f"$ Starting job in {image}\n"},
    )

    # Run in Docker
    success, log_output = run_job_in_docker(
        api_url, token, runner_id, image, script,
        project_id, pipeline_id, job_id
    )

    status = "success" if success else "failed"
    api_request(
        "POST",
        f"{api_url}/api/v1/projects/{project_id}/pipelines/{pipeline_id}/jobs/{job_id}/update_log/",
        token,
        data={"status": status},
    )
    print(f"Job finished: {status}")
    return True


def main():
    parser = argparse.ArgumentParser(description="MyGit CI Runner")
    parser.add_argument("--url", default=os.environ.get("MYGIT_API_URL", "http://127.0.0.1:8000"))
    parser.add_argument(
        "--token",
        default=os.environ.get("MYGIT_INTERNAL_API_TOKEN") or os.environ.get("MYGIT_API_TOKEN", ""),
    )
    parser.add_argument("--runner-id", default=os.environ.get("MYGIT_RUNNER_ID", "runner-1"))
    parser.add_argument("--interval", type=int, default=5)
    args = parser.parse_args()

    print(f"MyGit Runner starting: {args.runner_id}")
    print(f"API URL: {args.url}")

    while True:
        try:
            ran = run_job(args.url, args.token, args.runner_id)
            if not ran:
                time.sleep(args.interval)
        except KeyboardInterrupt:
            print("\nRunner stopped.")
            break
        except Exception as e:
            print(f"Error: {e}", file=sys.stderr)
            time.sleep(args.interval)


if __name__ == "__main__":
    main()
