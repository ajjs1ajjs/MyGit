#!/usr/bin/env python3
"""
MyGit SSH shell script.
Handles git push/pull requests over SSH.

Each key in authorized_keys has:
    command="/opt/mygit/scripts/mygit-shell <key_id>"

SSH_ORIGINAL_COMMAND will contain e.g. "git-upload-pack 'owner/repo.git'"
"""
import os
import re
import sys
import urllib.request

API_URL = os.environ.get("MYGIT_API_URL", "http://127.0.0.1:8000")
REPOS_ROOT = os.environ.get("MYGIT_REPOS_ROOT", "/opt/mygit/repos")


def main():
    key_id = sys.argv[1] if len(sys.argv) > 1 else ""
    original_cmd = os.environ.get("SSH_ORIGINAL_COMMAND", "")

    if not original_cmd:
        print("Hi there! This is MyGit. You've authenticated successfully, but interactive shell access is disabled.")
        print("Use: git clone, git push, or git pull.")
        sys.exit(1)

    parts = original_cmd.split(" ")
    verb = parts[0]
    repo_path = parts[1].strip("'") if len(parts) > 1 else ""

    if verb not in ("git-upload-pack", "git-receive-pack", "git-upload-archive"):
        print(f"Command not allowed: {verb}")
        sys.exit(1)

    if not re.match(r"^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+(\.git)?$", repo_path):
        print(f"Invalid repository path: {repo_path}")
        sys.exit(1)

    action = "pull" if "upload" in verb else "push"

    repo_api_path = repo_path[:-4] if repo_path.endswith(".git") else repo_path
    verified = check_access(key_id, repo_api_path, action)
    if not verified:
        print("Access denied.")
        sys.exit(1)

    repo_disk_path = os.path.realpath(os.path.join(REPOS_ROOT, repo_path))
    repos_root_real = os.path.realpath(REPOS_ROOT)
    if not repo_disk_path.startswith(repos_root_real + os.sep):
        print("Access denied: path traversal detected.")
        sys.exit(1)

    if not os.path.isdir(repo_disk_path):
        print(f"Repository not found: {repo_path}")
        sys.exit(1)

    env = os.environ.copy()
    env["GL_REPO"] = repo_api_path
    os.execvpe("git", [verb, repo_disk_path], env)


def check_access(key_id: str, repo_path: str, action: str) -> bool:
    url = f"{API_URL}/api/v1/internal/check_access"
    data = f"key_id={key_id}&repo_path={repo_path}&action={action}"
    req = urllib.request.Request(url, data=data.encode())

    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            return resp.status == 200
    except Exception:
        return False


if __name__ == "__main__":
    main()
