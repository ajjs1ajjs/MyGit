#!/usr/bin/env python3
"""
MyGit SSH AuthorizedKeysCommand script.
Called by OpenSSH to dynamically resolve SSH keys for a user.

Usage in /etc/ssh/sshd_config:
    AuthorizedKeysCommand /opt/mygit/scripts/mygit-authorized-keys
    AuthorizedKeysCommandUser mygit
"""
import json
import os
import sys
import urllib.request

API_URL = os.environ.get("MYGIT_API_URL", "http://127.0.0.1:8000")
API_TOKEN = os.environ.get("MYGIT_INTERNAL_API_TOKEN") or os.environ.get("MYGIT_API_TOKEN", "")


def get_authorized_keys(username: str) -> str:
    url = f"{API_URL}/api/v1/internal/authorized_keys?username={username}"
    req = urllib.request.Request(url)
    if API_TOKEN:
        req.add_header("Authorization", f"Bearer {API_TOKEN}")

    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read())
            lines = []
            for key_data in data.get("keys", []):
                key_id = key_data["id"]
                key_content = key_data["public_key"]
                cmd = f'/opt/mygit/scripts/mygit-shell {key_id}'
                options = f'command="{cmd}",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty'
                lines.append(f"{options} {key_content}")
            return "\n".join(lines)
    except Exception as e:
        sys.stderr.write(f"mygit-authorized-keys error: {e}\n")
        return ""


if __name__ == "__main__":
    username = sys.argv[1] if len(sys.argv) > 1 else ""
    print(get_authorized_keys(username))
