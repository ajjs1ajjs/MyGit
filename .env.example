# Django
DJANGO_SECRET_KEY=generate-with: openssl rand -base64 48
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://mygit:YOUR_PASSWORD@localhost:5432/mygit

# Redis
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# GIT
MYGIT_REPOS_ROOT=D:\Code\MyGit\repos
GIT_BINARY=git

# Internal API (protects SSH hooks endpoints, use: openssl rand -base64 48)
# MYGIT_INTERNAL_API_TOKEN=
# Export the same value as MYGIT_INTERNAL_API_TOKEN for SSH helper scripts.
# For SSH deployments the token is also read from /opt/mygit/.ssh-token
# (see setup.sh); add SSH users to the 'mygit' group to grant access:
#   usermod -aG mygit <username>

# Encryption key for stored third-party integration tokens (GitHub/GitLab).
# Must be a valid Fernet base64 key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, integration tokens fall back to a key derived from DJANGO_SECRET_KEY.
# ENCRYPTION_KEY=

# LDAP auth (optional second login method)
MYGIT_LDAP_ENABLED=False
# MYGIT_LDAP_SERVER_URI=ldap://ldap.example.com:389
# MYGIT_LDAP_BIND_DN=cn=readonly,dc=example,dc=com
# MYGIT_LDAP_BIND_PASSWORD=
# MYGIT_LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
# MYGIT_LDAP_USER_SEARCH_FILTER=(uid={username})
# MYGIT_LDAP_START_TLS=False

# Email (production)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@mygit.local

# Sentry (production)
# SENTRY_DSN=

# Backups
# Local directory for generated backup archives.
MYGIT_BACKUP_ROOT=./backups
# Number of local archives to keep after every successful create.
MYGIT_BACKUP_KEEP_LOCAL=14
# Optional cloud upload/download backend: rclone or s3.
# rclone target example: myremote:mygit/backups
# s3 target example: s3://my-company-backups/mygit
# MYGIT_BACKUP_CLOUD_PROVIDER=rclone
# MYGIT_BACKUP_CLOUD_TARGET=myremote:mygit/backups
# Optional encryption password for encrypted backup archives.
# Generate with: openssl rand -base64 48
# MYGIT_BACKUP_ENCRYPTION_KEY=
