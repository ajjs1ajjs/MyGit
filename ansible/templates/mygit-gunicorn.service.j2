[Unit]
Description=MyGit Gunicorn (Django WSGI)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service
Documentation=https://github.com/ajjs1ajjs/MyGit

[Service]
Type=notify
User={{ mygit_user }}
Group={{ mygit_group }}
WorkingDirectory={{ mygit_backend_dir }}
RuntimeDirectory=mygit-gunicorn
RuntimeDirectoryMode=0755

Environment=DJANGO_SETTINGS_MODULE={{ django_settings_module }}
EnvironmentFile={{ mygit_home }}/.env

ExecStart={{ mygit_venv_dir }}/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:{{ gunicorn_port }} \
    --workers {{ ansible_processor_vcpus | default(4) | int * 2 + 1 }} \
    --worker-class sync \
    --timeout 120 \
    --keep-alive 65 \
    --max-requests 4096 \
    --max-requests-jitter 512 \
    --access-logfile {{ mygit_log_dir }}/gunicorn-access.log \
    --error-logfile {{ mygit_log_dir }}/gunicorn-error.log \
    --log-level info \
    --capture-output \
    --enable-stdio-inheritance

ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

Restart=always
RestartSec=5

PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
