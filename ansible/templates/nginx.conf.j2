# MyGit Nginx Configuration
# Managed by Ansible - do not edit manually

upstream mygit_api {
    server 127.0.0.1:{{ gunicorn_port }};
}

upstream mygit_git_http {
    server 127.0.0.1:{{ git_http_port }};
}

server {
    listen {{ http_port }} default_server;
    listen [::]:{{ http_port }} default_server;
    server_name {{ domain }} {{ inventory_hostname }};
    server_tokens off;

    # ------------------------------------------------------------------
    # Security headers
    # ------------------------------------------------------------------
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy strict-origin-when-cross-origin;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";

    # ------------------------------------------------------------------
    # Gzip
    # ------------------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # ------------------------------------------------------------------
    # Static files (served directly by Nginx)
    # ------------------------------------------------------------------
    location /static/ {
        alias {{ mygit_static_root }}/;
        expires 365d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /media/ {
        alias {{ mygit_media_root }}/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ------------------------------------------------------------------
    # Prometheus metrics
    # ------------------------------------------------------------------
    location /metrics/ {
        proxy_pass http://mygit_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Restrict access in production — uncomment and set a valid CIDR:
        # allow 10.0.0.0/8;
        # allow 172.16.0.0/12;
        # deny all;
        access_log off;
    }

    # ------------------------------------------------------------------
    # Git Smart HTTP protocol
    # ------------------------------------------------------------------
    location ~ ^/(.+/.+)\.git/ {
        proxy_pass http://mygit_git_http;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        # Git clones/pushes can be large; disable buffering
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;

        # Timeouts for long-running Git operations
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ------------------------------------------------------------------
    # WebSocket (CI job logs)
    # ------------------------------------------------------------------
    location /ws/ {
        proxy_pass http://mygit_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # ------------------------------------------------------------------
    # Django Admin
    # ------------------------------------------------------------------
    location /django-admin/ {
        proxy_pass http://mygit_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ------------------------------------------------------------------
    # API & everything else → Daphne (ASGI)
    # ------------------------------------------------------------------
    location / {
        proxy_pass http://mygit_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        # WebSocket support (CI job logs)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        client_max_body_size 0;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ------------------------------------------------------------------
    # Deny access to hidden files
    # ------------------------------------------------------------------
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # ------------------------------------------------------------------
    # Access & error logs
    # ------------------------------------------------------------------
    access_log /var/log/nginx/mygit-access.log;
    error_log  /var/log/nginx/mygit-error.log warn;
}

