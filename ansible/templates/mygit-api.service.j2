[Unit]
Description=MyGit API (Daphne ASGI: HTTP + WebSockets)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service
Documentation=https://github.com/ajjs1ajjs/MyGit

[Service]
Type=simple
User={{ mygit_user }}
Group={{ mygit_group }}
WorkingDirectory={{ mygit_backend_dir }}
RuntimeDirectory=mygit-api
RuntimeDirectoryMode=0755

Environment=DJANGO_SETTINGS_MODULE={{ django_settings_module }}
EnvironmentFile={{ mygit_home }}/.env

ExecStart={{ mygit_venv_dir }}/bin/daphne \
    -b 127.0.0.1 \
    -p {{ gunicorn_port }} \
    --application-impl asyncio \
    config.asgi:application

ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

Restart=always
RestartSec=5

PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
