[Unit]
Description=MyGit Celery Worker
After=network.target redis-server.service
Requires=redis-server.service
PartOf=mygit-gunicorn.service
Documentation=https://github.com/ajjs1ajjs/MyGit

[Service]
Type=simple
User={{ mygit_user }}
Group={{ mygit_group }}
WorkingDirectory={{ mygit_backend_dir }}

Environment=DJANGO_SETTINGS_MODULE={{ django_settings_module }}
EnvironmentFile={{ mygit_home }}/.env

ExecStart={{ mygit_venv_dir }}/bin/celery -A config worker \
    --loglevel=info \
    --concurrency={{ ansible_processor_vcpus | default(2) | int * 2 }} \
    --max-tasks-per-child=4096 \
    --time-limit=3600 \
    --soft-time-limit=3300 \
    --without-gossip \
    --without-mingle \
    --without-heartbeat \
    --pidfile=/run/mygit/celery-worker.pid

ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

Restart=always
RestartSec=10

PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
