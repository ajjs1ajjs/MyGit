[Unit]
Description=MyGit Celery Beat (Scheduler)
After=network.target redis-server.service
Requires=redis-server.service
PartOf=mygit-celery.service
Documentation=https://github.com/ajjs1ajjs/MyGit

[Service]
Type=simple
User={{ mygit_user }}
Group={{ mygit_group }}
WorkingDirectory={{ mygit_backend_dir }}

Environment=DJANGO_SETTINGS_MODULE={{ django_settings_module }}
EnvironmentFile={{ mygit_home }}/.env

ExecStart={{ mygit_venv_dir }}/bin/celery -A config beat \
    --loglevel=info \
    --pidfile=/run/mygit/celery-beat.pid \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler

ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

Restart=always
RestartSec=10

PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
